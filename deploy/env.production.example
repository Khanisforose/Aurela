# Production .env template for Aurela on Hostinger VPS
# 1. Copy this file to /opt/aurela/.env
# 2. Change AURELA_JWT_SECRET (generate: openssl rand -hex 48)
# 3. Keep MONGO_URL pointing at the mongo container by service name

MONGO_URL=mongodb://mongo:27017
DB_NAME=aurela
NEXT_PUBLIC_BASE_URL=https://www.aurelawallet.com
CORS_ORIGINS=https://www.aurelawallet.com,https://aurelawallet.com

# CRITICAL — change to a long random secret in production
AURELA_JWT_SECRET=CHANGE-THIS-openssl-rand-hex-48

# Resend (email OTP) — domain aurelawallet.com must be verified in Resend dashboard
# Get your key at https://resend.com/api-keys and paste below
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
EMAIL_FROM=Aurela <noreply@aurelawallet.com>
EMAIL_SERVICE_CONFIGURED=1

# Google Sign-In — make sure https://www.aurelawallet.com is an Authorized JS Origin
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
